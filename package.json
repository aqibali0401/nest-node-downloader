{
  "name": "edge-sdm",
  "version": "1.0.0",
  "description": "Edge Software Deployment Manager - A comprehensive solution for managing software deployments across edge devices",
  "author": "QSC Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "download": "ts-node src/cli/simple-downloader.ts",
    "download:clean": "ts-node src/cli/simple-downloader.ts clean",
    "download:debug": "set DEBUG=true && ts-node src/cli/simple-downloader.ts",
    "migrate:sqlite": "ts-node src/scripts/migrate-to-sqlite.ts",
    "db:view": "ts-node src/scripts/view-database.ts",
    "db:query": "ts-node src/scripts/db-query.ts",
    "network:check": "ts-node src/scripts/network-status.ts",
    "test:offline": "ts-node src/scripts/test-offline.ts",
    "crash:test": "ts-node src/scripts/crash-testing.ts",
    "crash:simulate": "ts-node src/scripts/crash-simulation.ts",
    "recovery:test": "ts-node src/scripts/recovery-testing.ts",
    "test:offline-scenario": "ts-node src/scripts/test-offline-scenario.ts",
    "device:info": "ts-node src/scripts/device-info-simple.ts",
    "websocket": "ts-node src/scripts/simple-websocket.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@types/sqlite3": "^5.1.0",
    "@types/ws": "^8.18.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "systeminformation": "^5.21.15",
    "ws": "^8.18.3",
    "yauzl": "^2.10.0",
    "@types/yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
